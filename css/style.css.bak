* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	outline: none;
	font-family: Cambria, Cochin, Georgia, Times, "Times New Roman", serif;
	--primary: #f7cb71;
	--background: #151001;
	--text: #fdf1d6;
	--accent: #099724;
	--border-rad: 0.5rem;
	/* border: 1px solid white; */
}
html {
	scroll-behavior: smooth;
}
body {
	background: var(--background);
}
.container {
	width: 100%;
}
::selection {
	color: var(--accent);
	background-color: var(--primary);
	border-radius: var(--border-rad);
}
.btn {
	display: inline-block;
	width: min-content;
	height: min-content;
	padding: 0.5rem 1rem;
	text-decoration: none;
	border-radius: var(--border-rad);
	border: none;
}
.btn-block {
	background-color: var(--primary);
	color: var(--background);
	outline: 1px solid transparent;
	outline-offset: -1px;
	transition: 0.2s ease-out;
	&:hover {
		color: var(--primary);
		background: var(--background);
		outline-color: var(--primary);
	}
}
header {
	padding: 0 8%;
	position: absolute;
	background: linear-gradient(
		oklch(from var(--background) 0.2 c h),
		transparent
	);
	animation: --sticky-nav linear forwards;
	animation-timeline: view();
	animation-range-start: calc(120vh);
	animation-range-end: calc(170vh);
	.navbar {
		display: flex;
		flex-wrap: wrap;
		padding: 0.2rem 0;
		place-items: center;
		justify-content: space-between;
		.logo {
			width: 4rem;
		}
	}
	.nav-links {
		display: flex;
		flex-wrap: wrap;
		list-style: none;
		gap: 2rem;
		li a {
			padding: 0.5rem;
			text-decoration: none;
			color: var(--text);
			border: 1px solid transparent;
			border-radius: var(--border-rad);
			font-size: 1.2rem;
			transition: 0.2s ease-out;
		}
		li a:hover {
			background: oklch(from var(--text) l c h / 0.2);
			border-color: oklch(from var(--text) l c h / 0.3);
		}
	}
}

main .hero {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100vh;
	padding: 0 8%;
	gap: 5rem;
	background:
		linear-gradient(
			to top,
			var(--background),
			rgba(from var(--background) r g b / 0.7)
		),
		url(./../img/hero-image.jpg) center;
	background-size: cover;

	justify-content: center;
	align-items: center;

	h1 {
		font-size: clamp(2rem, calc(10vw + 1rem), 5rem);
		font-weight: 400;
		color: var(--text);
		text-wrap: balance;
		text-align: center;
		i {
			color: var(--primary);
			font-weight: 700;
			text-decoration-thickness: 4px;
			text-underline-offset: 10px;
		}
	}
	.hero-form {
		display: flex;
		flex-wrap: wrap;
		width: min(900px, 90%);
		padding: 1rem;
		background-color: var(--text);
		border-radius: var(--border-rad);
		justify-content: space-between;
		align-items: center;
		transition: 0.2s ease-out;
		&:focus-within,
		&:hover {
			box-shadow: 0 10px 20px var(--background);
		}
		.form-input label {
			font-size: 1.2rem;
			transition: 0.2s ease-out;
			flex: 1;
			:has(&):focus-within > & {
				font-size: 0.8rem;
			}
		}
		.form-input input,
		.form-input select {
			display: block;
			padding: 0.5rem;
			padding-left: 0;
			background: transparent;
			border: none;
			font-weight: 400;
		}
		button {
			display: block;
			width: 60px;
			height: 60px;
			font-size: 1.2em;
		}
	}
}

main .un {
	height: 100vh;
}

@keyframes --sticky-nav {
	100% {
		position: fixed;
		top: 0;
		background: oklch(from var(--background) l c h / 0.5);
		backdrop-filter: blur(6px);
		border-bottom: 1px oklch(from var(--primary) l c h / 0.1) solid;
		box-shadow: 5px 0 15px var(--background);
	}
	20% {
		position: fixed;
		top: -200px;
	}
	0% {
		position: absolute;
		top: 0;
	}
}
